# Enter new or rotated values privately; never commit an actual .env file.
NODE_ENV=production
APP_BASE_URL=https://your-project.vercel.app
MONGODB_URI=
# Preserve the original LearnFlow database when rotating the connection string.
MONGODB_DB_NAME=learnFlow
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google authorized redirect URI: APP_BASE_URL/auth/google/callback
# Optional for avatar uploads; use a bucket-scoped IAM credential.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=learnflow-resource-bucket
S3_PUBLIC_BASE_URL=https://d1ecyonmvcaoie.cloudfront.net
